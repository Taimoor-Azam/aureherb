{
  "name": "aureherb",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:migrate": "pnpm --filter=@dtc/backend exec medusa db:migrate",
    "backend:seed": "pnpm --filter=@dtc/backend exec medusa db:migrate",
    "backend:user": "pnpm --filter=@dtc/backend exec medusa user -e admin@aureherb.local -p supersecret",
    "backend:dev": "pnpm --filter=@dtc/backend dev",
    "storefront:dev": "pnpm --filter=@dtc/storefront dev"
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.16.0",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.14"
  }
}
